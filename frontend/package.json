		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@types/eslint": "^9.6.1",
		"@types/node": "^24.0.3",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.29.0",
		"eslint-config-prettier": "^10.1.5",
		"eslint-plugin-svelte": "^3.9.3",
		"globals": "^16.2.0",
		"prettier": "^3.5.3",
		"prettier-plugin-svelte": "^3.4.0",
		"sass-embedded": "^1.89.2",
		"svelte": "^5.34.7",
		"svelte-check": "^4.2.2",
		"tailwindcss": "^4.1.10",
